#!/usr/bin/env bash
set -euo pipefail

APP_DIR="$(readlink -f "$(dirname "${BASH_SOURCE[0]}")/..")"
DATA_ROOT="${APP_DATA_DIR:-${APP_DIR}}"
TARGET_DIR="${DATA_ROOT}/data"

mkdir -p "${TARGET_DIR}/auth" "${TARGET_DIR}/static"

CONFIG_FILE="${TARGET_DIR}/config.yaml"

if [ ! -f "${CONFIG_FILE}" ]; then
  cat << 'EOF' > "${CONFIG_FILE}"
config-version: 8

server:
  host: "0.0.0.0"
  port: 8317

management:
  allow-remote: true
  secret-key: "umbrel"
  disable-control-panel: false
  panel-github-repository: "https://github.com/router-for-me/Cli-Proxy-API-Management-Center"

oauth:
  auth-dir: "/CLIProxyAPI/data/auth"

access:
  api-keys:
    - "sk-cliproxy-umbrel"
EOF
  chmod 600 "${CONFIG_FILE}"
fi
