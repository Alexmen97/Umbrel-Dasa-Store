#!/usr/bin/env bash

set -euo pipefail

APP_DIR="${APP_DATA_DIR:-$(readlink -f "$(dirname "${BASH_SOURCE[0]}")/..")}"

containers="$(docker ps -a --filter "name=dasa-coolify" -q 2>/dev/null || true)"
if [[ -n "${containers}" ]]; then
  docker rm -f ${containers} >/dev/null 2>&1 || true
fi

rm -f "${APP_DIR}/data/docker/docker.pid" "${APP_DIR}/data/docker/docker.sock" 2>/dev/null || true
