#!/usr/bin/env bash
set -euo pipefail
APP_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
DATA_DIR="${APP_DIR}/data/openbot"
# Only initialize the mount root. Never recursively chown agent-controlled files.
if [[ -L "${DATA_DIR}" ]]; then
  printf '%s
' "Refusing symlink data directory: ${DATA_DIR}" >&2
  exit 1
fi
install -d -m 0700 -o 1000 -g 1000 "${DATA_DIR}"
